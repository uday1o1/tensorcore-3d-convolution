ssh -o StrictHostKeyChecking=no -o ConnectTimeout=30 <host> "
cd /workspace/win3d && source /venv/main/bin/activate
python3 << 'PYEOF'
import torch, torch.nn.functional as F, time
from winconv import im2win_conv3d, im2win_conv3d_minmat
torch.backends.cudnn.benchmark=True
def t(fn,n=20):
    for _ in range(8): fn()
    torch.cuda.synchronize(); t0=time.time()
    for _ in range(n): fn()
    torch.cuda.synchronize(); return (time.time()-t0)/n
print('nnU-Net 3D layers: cuDNN vs two windowed materialization strategies')
print(f'{\"layer\":>16} {\"cuDNN\":>7} {\"k^2-mat\":>8} {\"k-mat\":>7} {\"r(k^2)\":>7} {\"r(k)\":>6}')
L=[(30,30,128),(30,60,64),(60,60,64),(60,120,32),(120,120,32),(120,240,16),(240,240,16),(240,320,8),(320,320,8)]
ra,rb=[],[]
for cin,cout,sp in L:
    B=2
    x=torch.randn(B,cin,sp,sp,sp,device='cuda',dtype=torch.half)
    w=torch.randn(cout,cin,3,3,3,device='cuda',dtype=torch.half)
    o=(sp-3)+1; ops=2*B*cout*o*o*o*cin*27
    tc=t(lambda:F.conv3d(x,w))
    t2=t(lambda:im2win_conv3d(x,w))
    t1=t(lambda:im2win_conv3d_minmat(x,w))
    ra.append(tc/t2); rb.append(tc/t1)
    print(f'{cin:5d}->{cout:<5d}{sp:4d} {ops/tc/1e12:7.2f} {ops/t2/1e12:8.2f} {ops/t1/1e12:7.2f} {tc/t2:6.2f}x {tc/t1:5.2f}x')
    del x,w; torch.cuda.empty_cache()
import math
gm=lambda v: math.exp(sum(math.log(z) for z in v)/len(v))
print()
print(f'3D geomean, k^2 materialization (unfold D+H): {gm(ra):.3f}x')
print(f'3D geomean, k   materialization (unfold D)  : {gm(rb):.3f}x')
print(f'2D geomean (measured previously)            : 0.591x')
PYEOF
" 2>&1 | tail -16
