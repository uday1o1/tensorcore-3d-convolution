# command
ssh -o StrictHostKeyChecking=no <host> "
source /venv/main/bin/activate
python3 << 'EOF'
import torch
from fvcore.nn import FlopCountAnalysis
from nnunet_mednext.network_architecture.mednextv1.create_mednext_v1 import create_mednext_v1

model = create_mednext_v1(num_input_channels=1, num_classes=2, model_id='B', kernel_size=3).cuda()
x = torch.zeros((1, 1, 128, 128, 128), device='cuda')
flops = FlopCountAnalysis(model, x)
flops.unsupported_ops_warnings(False)
total_flops = flops.total()
print(f'Total FLOPs: {total_flops:.3e} ({total_flops/1e9:.1f} GFLOPs)')

by_mod = flops.by_module()
conv1_flops = 0
for name, count in by_mod.items():
    if name.endswith('.conv1') or name == 'conv1':
        conv1_flops += count

pct = (conv1_flops / total_flops) * 100 if total_flops > 0 else 0
print(f'conv1 total FLOPs: {conv1_flops:.3e} ({pct:.1f}% of total)')

# also show top-level breakdown for sanity
print('--- top modules by flops ---')
for name, count in sorted(by_mod.items(), key=lambda x: -x[1])[:10]:
    if count > 0:
        print(f'{(count/total_flops)*100:5.1f}%  {name}')
EOF
" 2>&1 | tail -25
