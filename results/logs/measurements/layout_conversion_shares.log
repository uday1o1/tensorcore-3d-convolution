python3 << 'PYEOF'
import torch, torch.nn.functional as F, time
from torch.profiler import profile, ProfilerActivity
from winconv import im2win_conv3d_minmat
torch.backends.cudnn.benchmark=True

def layout_share(fn, label):
    for _ in range(8): fn()
    torch.cuda.synchronize()
    with profile(activities=[ProfilerActivity.CUDA]) as pr:
        for _ in range(10): fn()
        torch.cuda.synchronize()
    ev=[e for e in pr.key_averages() if e.self_device_time_total>0]
    T=sum(e.self_device_time_total for e in ev)
    lay=sum(e.self_device_time_total for e in ev if ('ToNhwc' in e.key or 'ToNchw' in e.key or 'nchwToNhwc' in e.key or 'nhwcToNchw' in e.key))
    cpy=sum(e.self_device_time_total for e in ev if ('Memcpy' in e.key or 'Memset' in e.key))
    print(f'{label}: layout {lay/T*100:5.1f}%  memcpy/set {cpy/T*100:5.1f}%  total {T/1000:.2f} ms/10it')
    return lay/T*100, cpy/T*100

print('LAYOUT CONVERSION TEST: does the windowed path avoid cuDNN NCHW<->NHWC cost?')
print()
for (cin,cout,sp) in [(60,60,64),(120,120,32),(240,240,16)]:
    B=2
    x=torch.randn(B,cin,sp,sp,sp,device='cuda',dtype=torch.half)
    w=torch.randn(cout,cin,3,3,3,device='cuda',dtype=torch.half)
    print(f'--- layer {cin}->{cout} @ {sp}^3 ---')
    layout_share(lambda: F.conv3d(x,w), '  cuDNN conv3d    ')
    layout_share(lambda: im2win_conv3d_minmat(x,w), '  windowed (k-mat)')
    del x,w; torch.cuda.empty_cache()
PYEOF
" 2>&1 | tail -14
