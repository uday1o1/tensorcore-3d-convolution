import torch, torch.nn.functional as F
from fftconv import fft_conv3d
torch.backends.cuda.matmul.allow_tf32=False; torch.backends.cudnn.allow_tf32=False
print('FFT conv correctness:')
for (B,C,D,Co,k) in [(1,4,12,3,3),(2,8,16,6,5),(1,6,14,4,7)]:
    x=torch.randn(B,C,D,D,D,device='cuda'); w=torch.randn(Co,C,k,k,k,device='cuda')
    ref=F.conv3d(x,w); got=fft_conv3d(x,w)
    if ref.shape!=got.shape: print(f'  SHAPE C{C} k{k}: {ref.shape} vs {got.shape}'); continue
    rel=(ref-got).abs().max().item()/ref.abs().max().item()
    print(f'  {\\\"OK\\\" if rel<1e-4 else \\\"FAIL\\\"} C{C} D{D} k{k}: rel {rel:.2e}')
\"
