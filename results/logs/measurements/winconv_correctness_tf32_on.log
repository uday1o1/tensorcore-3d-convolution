import torch, torch.nn.functional as F
from winconv import im2win_conv2d, im2win_conv3d
torch.manual_seed(0); ok=True
print('=== 2D ===')
for (B,C,H,W,Co,k,s) in [(2,8,16,16,4,3,1),(1,3,9,9,5,3,1),(4,16,32,32,32,3,1),
                         (2,30,24,24,60,3,1),(1,64,56,56,64,3,1),(3,7,15,13,11,3,1),
                         (2,8,16,16,4,5,1),(2,8,17,19,4,3,2)]:
    x=torch.randn(B,C,H,W,device='cuda'); w=torch.randn(Co,C,k,k,device='cuda')
    ref=F.conv2d(x,w,stride=s); got=im2win_conv2d(x,w,stride=s)
    rel=(ref-got).abs().max().item()/ref.abs().max().item()
    f='OK' if rel<1e-4 else 'FAIL';  ok &= (rel<1e-4)
    print(f'  {f} B{B} C{C} {H}x{W} Co{Co} k{k} s{s}: rel_err {rel:.2e}')
print('=== 3D ===')
for (B,C,D,H,W,Co,k,s) in [(2,4,8,8,8,3,3,1),(1,3,7,9,11,5,3,1),(2,30,16,16,16,30,3,1),
                           (1,16,12,12,12,32,3,1),(2,8,10,10,10,4,3,2)]:
    x=torch.randn(B,C,D,H,W,device='cuda'); w=torch.randn(Co,C,k,k,k,device='cuda')
    ref=F.conv3d(x,w,stride=s); got=im2win_conv3d(x,w,stride=s)
    rel=(ref-got).abs().max().item()/ref.abs().max().item()
    f='OK' if rel<1e-4 else 'FAIL'; ok &= (rel<1e-4)
    print(f'  {f} B{B} C{C} {D}x{H}x{W} Co{Co} k{k} s{s}: rel_err {rel:.2e}')
print()
print('ALL CORRECT' if ok else 'STILL FAILING')
PYEOF
