ssh -o StrictHostKeyChecking=no -o ConnectTimeout=25 <host> "
cd /workspace/win3d && source /venv/main/bin/activate
python3 << 'PYEOF'
import torch, torch.nn.functional as F, time, math
from winconv import im2win_conv3d_minmat
torch.backends.cudnn.benchmark=True
def t(fn,n=15):
    for _ in range(6): fn()
    torch.cuda.synchronize(); t0=time.time()
    for _ in range(n): fn()
    torch.cuda.synchronize(); return (time.time()-t0)/n

# correctness at each k first
torch.backends.cuda.matmul.allow_tf32=False; torch.backends.cudnn.allow_tf32=False
print('correctness by kernel size:')
for k in [3,5,7]:
    x=torch.randn(2,16,20,20,20,device='cuda'); w=torch.randn(32,16,k,k,k,device='cuda')
    ref=F.conv3d(x,w); got=im2win_conv3d_minmat(x,w)
    rel=(ref-got).abs().max().item()/ref.abs().max().item()
    print(f'  k={k}: rel_err {rel:.2e} {\"OK\" if rel<1e-5 else \"FAIL\"}')
torch.backends.cudnn.allow_tf32=True
print()
print('PREDICTION: minimal materialization grows as k, reduction depth as k^3,')
print('so intensity rises with k and windowed should improve with larger kernels.')
print()
print(f'{\"layer\":>14} {\"k\":>2} {\"cuDNN\":>8} {\"windowed\":>9} {\"ratio\":>7} {\"intensity\":>10}')
for (cin,cout,sp) in [(60,60,64),(120,120,32),(240,240,16)]:
    for k in [3,5,7]:
        B=2
        if sp-k+1 < 2: continue
        x=torch.randn(B,cin,sp,sp,sp,device='cuda',dtype=torch.half)
        w=torch.randn(cout,cin,k,k,k,device='cuda',dtype=torch.half)
        o=sp-k+1; ops=2*B*cout*o*o*o*cin*k*k*k
        tc=t(lambda:F.conv3d(x,w)); tw=t(lambda:im2win_conv3d_minmat(x,w))
        inten=ops/(B*cin*sp*sp*sp*2)
        print(f'{cin:5d}->{cout:<5d}{sp:3d} {k:2d} {ops/tc/1e12:8.2f} {ops/tw/1e12:9.2f} {tc/tw:6.2f}x {inten:10.0f}')
        del x,w; torch.cuda.empty_cache()
PYEOF
" 2>&1 | tail -20
