import torch, torch.nn.functional as F, time
from winconv import im2win_conv3d, im2win_conv3d_minmat
torch.backends.cuda.matmul.allow_tf32=False; torch.backends.cudnn.allow_tf32=False
print('=== correctness of minimal-materialization 3D ===')
ok=True
for (B,C,D,H,W,Co,k,s) in [(2,4,8,8,8,3,3,1),(2,30,16,16,16,60,3,1),(1,16,12,12,12,32,3,1),(2,8,10,10,10,4,3,2)]:
    x=torch.randn(B,C,D,H,W,device='cuda'); w=torch.randn(Co,C,k,k,k,device='cuda')
    ref=F.conv3d(x,w,stride=s); got=im2win_conv3d_minmat(x,w,stride=s)
    rel=(ref-got).abs().max().item()/ref.abs().max().item(); ok &= rel<1e-5
    print(f'  {\"OK\" if rel<1e-5 else \"FAIL\"} C{C} {D}x{H}x{W} Co{Co} k{k} s{s}: {rel:.2e}')
print('CORRECT' if ok else 'FAILED')
PYEOF
