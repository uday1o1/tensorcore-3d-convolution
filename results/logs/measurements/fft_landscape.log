import torch, torch.nn.functional as F, time, statistics as st
from winconv import im2win_conv3d_minmat
from fftconv import fft_conv3d
torch.backends.cudnn.benchmark=True

def t(fn,n=10):
    for _ in range(4): fn()
    torch.cuda.synchronize(); t0=time.time()
    for _ in range(n): fn()
    torch.cuda.synchronize(); return (time.time()-t0)/n

def safe(fn):
    try: return t(fn)
    except (torch.cuda.OutOfMemoryError, RuntimeError):
        torch.cuda.empty_cache(); return None

print('LARGE-KERNEL 3D CONVOLUTION: algorithm landscape')
print('ratio = cuDNN_time / algo_time   (>1.0 means algo BEATS cuDNN)')
print()
print(f'{\"layer\":>16} {\"k\":>2} {\"cuDNN ms\":>9} {\"win\":>7} {\"fft\":>7} {\"r_win\":>7} {\"r_fft\":>7}')
for (cin,cout,sp) in [(60,60,64),(120,120,32)]:
    for k in [3,5,7,9,11]:
        B=2
        if sp-k+1 < 2: continue
        try:
            x=torch.randn(B,cin,sp,sp,sp,device='cuda',dtype=torch.half)
            w=torch.randn(cout,cin,k,k,k,device='cuda',dtype=torch.half)
        except torch.cuda.OutOfMemoryError:
            torch.cuda.empty_cache(); continue
        tc=safe(lambda:F.conv3d(x,w))
        tw=safe(lambda:im2win_conv3d_minmat(x,w))
        tf=safe(lambda:fft_conv3d(x,w))
        f=lambda v: f'{v*1000:7.2f}' if v else '    oom'
        rw=f'{tc/tw:6.2f}x' if (tc and tw) else '    -- '
        rf=f'{tc/tf:6.2f}x' if (tc and tf) else '    -- '
        print(f'{cin:5d}->{cout:<5d}{sp:4d} {k:2d} {f(tc)} {f(tw)} {f(tf)} {rw} {rf}', flush=True)
        del x,w; torch.cuda.empty_cache()
PYEOF
