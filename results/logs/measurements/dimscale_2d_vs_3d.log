ssh -o StrictHostKeyChecking=no -o ConnectTimeout=30 <host> "
cd /workspace/win3d && source /venv/main/bin/activate
python3 << 'PYEOF'
import torch, torch.nn.functional as F, time
from winconv import im2win_conv2d, im2win_conv3d
torch.backends.cudnn.benchmark=True
def t(fn,n=20):
    for _ in range(8): fn()
    torch.cuda.synchronize(); t0=time.time()
    for _ in range(n): fn()
    torch.cuda.synchronize(); return (time.time()-t0)/n

print('nnU-Net 2D layers (512x512 patch, batch 16, base 30)   [cuDNN / windowed, TFLOPS]')
print(f'{\"layer\":>16} {\"cuDNN\":>8} {\"windowed\":>9} {\"ratio\":>7} {\"intensity\":>10}')
L2=[(30,30,512),(30,60,256),(60,60,256),(60,120,128),(120,120,128),(120,240,64),(240,240,64),(240,480,32),(480,480,32),(480,480,16)]
r2=[]
for cin,cout,sp in L2:
    B=16
    try:
        x=torch.randn(B,cin,sp,sp,device='cuda',dtype=torch.half)
        w=torch.randn(cout,cin,3,3,device='cuda',dtype=torch.half)
        o=(sp-3)+1; ops=2*B*cout*o*o*cin*9
        tc=t(lambda:F.conv2d(x,w)); tw=t(lambda:im2win_conv2d(x,w))
        inten=ops/(B*cin*sp*sp*2)
        r2.append(tc/tw)
        print(f'{cin:5d}->{cout:<5d}{sp:4d} {ops/tc/1e12:8.2f} {ops/tw/1e12:9.2f} {tc/tw:6.2f}x {inten:10.0f}')
        del x,w; torch.cuda.empty_cache()
    except RuntimeError as e:
        print(f'{cin:5d}->{cout:<5d}{sp:4d}  OOM/err')
print(f'  2D geometric mean ratio: {torch.tensor(r2).log().mean().exp():.3f}x')
print()
print('nnU-Net 3D layers (128^3 patch, batch 2, base 30)')
print(f'{\"layer\":>16} {\"cuDNN\":>8} {\"windowed\":>9} {\"ratio\":>7} {\"intensity\":>10}')
L3=[(30,30,128),(30,60,64),(60,60,64),(60,120,32),(120,120,32),(120,240,16),(240,240,16),(240,320,8),(320,320,8),(320,320,4)]
r3=[]
for cin,cout,sp in L3:
    B=2
    try:
        x=torch.randn(B,cin,sp,sp,sp,device='cuda',dtype=torch.half)
        w=torch.randn(cout,cin,3,3,3,device='cuda',dtype=torch.half)
        o=(sp-3)+1; ops=2*B*cout*o*o*o*cin*27
        tc=t(lambda:F.conv3d(x,w)); tw=t(lambda:im2win_conv3d(x,w))
        inten=ops/(B*cin*sp*sp*sp*2)
        r3.append(tc/tw)
        print(f'{cin:5d}->{cout:<5d}{sp:4d} {ops/tc/1e12:8.2f} {ops/tw/1e12:9.2f} {tc/tw:6.2f}x {inten:10.0f}')
        del x,w; torch.cuda.empty_cache()
    except RuntimeError as e:
        print(f'{cin:5d}->{cout:<5d}{sp:4d}  OOM/err')
print(f'  3D geometric mean ratio: {torch.tensor(r3).log().mean().exp():.3f}x')
PYEOF
